{
    "name": "united-workspace/saltoks-api",
    "description": "PHP SDK for the Salto KS Connect API (Generated)",
    "keywords": [
        "saltoks",
        "salto",
        "clay",
        "php",
        "sdk",
        "api"
    ],
    "homepage": "https://github.com/United-Workspace/saltoks-php-client",
    "license": "proprietary",
    "authors": [
        {
            "name": "United Workspace GmbH",
            "email": "sebastian.fuss@united-workspace.de"
        },
        {
            "name": "Salto KS Support",
            "email": "api@saltoks.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^4.8",
        "squizlabs/php_codesniffer": "~2.6",
        "friendsofphp/php-cs-fixer": "~2.12"
    },
    "autoload": {
        "psr-4": {
            "SaltoKS\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SaltoKS\\": "test/"
        }
    }
}
